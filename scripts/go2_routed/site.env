# Site values for the routed GO2 telemetry path (docs/go2-routed-telemetry.md).
# Recorded from the 2026-11-10 lab session. Check every value before a session;
# the scripts refuse to run when an interface or address does not match.

# GO2 internal network (192.168.123.0/24). The firmware participants all use this address.
GO2_IP=192.168.123.161
# Payload Jetson: wired link to the GO2 switch, and its lab Wi-Fi.
JETSON_ROBOT_IF=enP8p1s0
JETSON_ROBOT_IP=192.168.123.18
JETSON_LAN_IF=wlx3c64cf2d28e2
JETSON_LAN_IP=192.168.0.70
# Telemetry host (lab PC) on the same Wi-Fi.
HOST_LAN_IF=wlxc01c303625d6
HOST_LAN_IP=192.168.0.137
# Address on the robot subnet that the host uses as its DDS locator. It must be
# unused on the robot network; jetson_path.sh up checks this before proxying ARP for it.
HOST_ROBOT_IF=go2fwd
HOST_ROBOT_IP=192.168.123.137
# DDS domain 0 discovery: firmware SPDP multicast, and the host's unicast
# discovery port for ParticipantIndex 0 (7400 + 10 + 2 * 0).
DDS_GROUP=239.255.0.1
DDS_PORT=7400
HOST_SPDP_PORT=7410
# Highest DDS port of domain 0 that a participant can use (MaxAutoParticipantIndex 250).
DDS_PORT_MAX=7911
# The relay stops by itself after this long.
RELAY_MAX_SECONDS=900
# Tag on every iptables rule and the directory for recorded prior state.
TAG=go2-routed-telemetry
STATE_DIR=/run/go2-routed-telemetry
